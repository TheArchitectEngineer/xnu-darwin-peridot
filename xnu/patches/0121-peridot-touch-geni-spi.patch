--- a/bsd/dev/peridot_touch.c
+++ b/bsd/dev/peridot_touch.c
@@ -76,6 +76,23 @@
  * MSB-to-LSB, length 8, STOP only on vector 3. FIFO bytes remain LSB first. */
 #define SE_PACK0        0x0007f8feu
 #define SE_PACK1        0x000ffefeu
+/*
+ * GENI_FW_REVISION_RO (0x68) [15:8] is the protocol, not a QUP version:
+ * NONE=0 SPI=1 UART=2 I2C=3 I3C=4 (include/linux/soc/qcom/geni-se.h). The
+ * peridot IC (xiaomi_touch@0) hangs off spi@a90000 = GENI SE4 SPI, so the
+ * expected value is SPI (1), not the I2C (3) of the sweet/topaz bring-up.
+ */
+#define GENI_PROTO_SPI  1u
+/* GENI SPI protocol registers (drivers/spi/spi-geni-qcom.c). */
+#define SE_SPI_CPHA     0x224u
+#define SE_SPI_CPOL     0x230u
+#define SE_SPI_DEMUX_SEL 0x250u
+#define SE_SPI_TRANS_CFG 0x25cu
+#define SE_SPI_WORD_LEN 0x268u
+#define SE_SPI_PRE_POST_CMD_DLY 0x274u
+#define SPI_TX_ONLY     (1u << 27)
+#define SPI_RX_ONLY     (2u << 27)
+#define M_CMD_DONE      (1u << 0)
 
 static struct {
 	vm_offset_t se;
@@ -210,6 +227,8 @@
 touch_msg_run(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
     unsigned nr, bool stretch)
 {
+	(void)addr;
+	(void)stretch;
 	if (st.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
 		return EIO;
 	}
@@ -218,10 +237,14 @@
 		return EBUSY;
 	}
 	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	/*
+	 * GENI SPI runs the primary sequencer with a TX-only or RX-only opcode
+	 * (no I2C address field). The register address travels as the first TX
+	 * bytes; a read is a separate RX-only transfer after it.
+	 */
 	touch_wr(st.se, SE_TX_WM, nt ? 1u : 0u);
 	touch_wr(st.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
-	touch_wr(st.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
-	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	touch_wr(st.se, SE_CMD, nr ? SPI_RX_ONLY : SPI_TX_ONLY);
 	int err = ETIMEDOUT;
 	for (unsigned i = 0; i < 20000; ++i) {
 		uint32_t irq = touch_irq();
@@ -488,24 +511,24 @@
