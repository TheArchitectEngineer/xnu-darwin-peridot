-	 * The QUP wrapper and GENI are outside this SE page; read them so the
-	 * next boot shows whether ABL left QUPv3 configured (proto 3) or the
-	 * block is unclocked (reads back a default 0x102).
+	 * GENI_FW_REVISION_RO[15:8] is the protocol. peridot's IC is on GENI SE4
+	 * SPI, so the expected value is SPI (1). Keep the QUP/GENI state in the
+	 * log so an unclocked block (which reads back a default 0x102) is obvious.
 	 */
-	printf("PERIDOT TOUCH: geni se_geni=%#x out=%#x m_irq=%#x s_irq=%#x io=%#x ver=%#x\n",
-	    touch_rd(st.se, 0x0), touch_rd(st.se, 0x4), touch_rd(st.se, 0x20),
-	    touch_rd(st.se, 0x24), touch_rd(st.se, 0x908), touch_rd(st.se, 0x0));
+	printf("PERIDOT TOUCH: geni se_geni=%#x out=%#x m_irq=%#x s_irq=%#x clk_sel=%#x\n",
+	    touch_rd(st.se, 0x0), touch_rd(st.se, 0x24), touch_rd(st.se, 0x610),
+	    touch_rd(st.se, 0x640), touch_rd(st.se, SE_CLK_SEL));
 	int force = 0;
 	(void)PE_parse_boot_argn("peridottouchforce", &force, sizeof(force));
 	bool fifo_ok = ((tx >> 24) & 0x3fu) == 32u && ((rx >> 24) & 0x3fu) == 32u &&
