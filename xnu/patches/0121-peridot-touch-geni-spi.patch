-	printf("PERIDOT TOUCH: se7 fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n",
+	printf("PERIDOT TOUCH: se4 fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n",
 	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx,
 	    touch_rd(st.se, 0x908));
