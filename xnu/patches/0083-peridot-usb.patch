+		*(volatile uint32_t *)(dwc + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		*(volatile uint32_t *)(dwc + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
