+/*
+ * Bring-up trace for the IPC paths that can hold the SpringBoard launch.
+ * Log message metadata only: payloads can contain credentials and user data.
+ */
+static bool
+peridot_ipc_trace_enabled(void)
+{
+	const char *name = proc_name_address(current_proc());
+	static const char * const traced[] = {
+		"SpringBoard", "mobileactivationd", "runningboardd", "backboardd",
+		"launchd", "lockdownd", "cfprefsd", "installd", "lsd"
+	};
+
+	if (name == NULL) {
+		return false;
+	}
+	for (unsigned int i = 0; i < sizeof(traced) / sizeof(traced[0]); i++) {
+		const char *a = name, *b = traced[i];
+		while (*a != '\0' && *a == *b) {
+			a++;
+			b++;
+		}
+		if (*a == '\0' && *b == '\0') {
+			return true;
+		}
+	}
+	return false;
+}
+#endif /* ARM64_BOARD_CONFIG_PERIDOT */
