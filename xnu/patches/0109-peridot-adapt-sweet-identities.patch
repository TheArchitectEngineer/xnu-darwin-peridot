peridot: replace remaining sweet (SM7150) identities with peridot (SM8635)

The 0003-0081 base series was renamed from ios-sweet without auditing
every hardware description. mkadt.py and the 0082-0108 adaptation layer
already carry the real peridot values (GIC 0x17100000, framebuffer
0xE3940000, vtimer INTID 27, qcom,kryo match); this patch updates the
stragglers that still describe the sweet board, per PORTING.md:

- CPU topology: 3x A520 (MPIDR Aff1 0x0-0x2), 4x A720 (0x3-0x6),
  1x X4 (0x700) - not "six A55 + two A76" (sweet's SM7150 layout).
- PeridotCPU cpuName "Kryo 470" -> "Kryo", matching the qcom,kryo
  compatible string in the ADT and KernelConfigTables (0082).
- MASTER.arm64.peridot header, proc_reg.h cache-line comment,
  MakeInc.def arch-string comment, tunables.s stub comment and the
  machine_routines.c cluster-ID comment: SM7150 -> SM8635.

Comments and one registry string only; no behavioural change.

diff --git a/iokit/Kernel/arm/PeridotCPU.cpp b/iokit/Kernel/arm/PeridotCPU.cpp
--- a/iokit/Kernel/arm/PeridotCPU.cpp
+++ b/iokit/Kernel/arm/PeridotCPU.cpp
@@ -1,7 +1,8 @@
 /*
- * A55 SMP bring-up for peridot using XNU's legacy IOCPU interface and PSCI.
+ * SMP bring-up for peridot using XNU's legacy IOCPU interface and PSCI.
  * The architected timer and SGI1 already enter through pe_fiq/sleh_irq.
- * CPU_OFF, suspend and the A76 cores still require separate platform work.
+ * CPU_OFF and suspend still require separate platform work; the X4/A720
+ * cores run as if homogeneous with the A520s (no AMP/P-E clusters yet).
  */
 #include <pexpert/arm64/board_config.h>
 
@@ -73,7 +74,7 @@
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
-	/* MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
+	/* MPIDR Aff1 = core: 3x A520 0x000-0x200, 4x A720 0x300-0x600, X4 0x700 */
 	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
 	    topology->num_cpus > PERIDOT_SMP_MAX_CPUS) {
 		panic("PERIDOT CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
@@ -82,7 +83,7 @@
 	if (!IOCPU::start(provider)) {
 		return false;
 	}
-	cpuName = OSSymbol::withCStringNoCopy("Kryo 470");
+	cpuName = OSSymbol::withCStringNoCopy("Kryo");
 	if (cpuName == NULL) {
 		return false;
 	}
@@ -144,7 +145,7 @@
 		}
 		IOSleep(1);
 	}
-	/* The supplied ADT has cpu0 as the boot CPU and ascending A55 nodes. */
+	/* The supplied ADT has cpu0 as the boot CPU and ascending Kryo nodes. */
 	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0) {
 		panic("PERIDOT CPU: expected boot MPIDR 0 and logical CPU 0");
 	}
diff --git a/pexpert/pexpert/arm64/PERIDOT.h b/pexpert/pexpert/arm64/PERIDOT.h
--- a/pexpert/pexpert/arm64/PERIDOT.h
+++ b/pexpert/pexpert/arm64/PERIDOT.h
@@ -18,10 +18,10 @@
 #define PERIDOT                     1
 
 /*
- * All eight cores (six A55 + two A76) as one homogeneous SMP cluster:
- * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
- * CPU_ON; the scheduler does not know the A76s are faster (no AMP/P-E
- * clusters yet).
+ * All eight cores (3x A520 + 4x A720 + 1x X4) as one homogeneous SMP
+ * cluster: cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte
+ * lines, PSCI CPU_ON; the scheduler does not know the X4/A720 cores are
+ * faster (no AMP/P-E clusters yet).
  */
 #define PERIDOT_SMP_MAX_CPUS         8
 
diff --git a/config/MASTER.arm64.peridot b/config/MASTER.arm64.peridot
--- a/config/MASTER.arm64.peridot
+++ b/config/MASTER.arm64.peridot
@@ -1,5 +1,5 @@
 #
-# peridot (Redmi Note 10 Pro, SM7150): MASTER.arm64.MacOSX plus the open-source
+# peridot (Poco F6, SM8635): MASTER.arm64.MacOSX plus the open-source
 # arm64 assembly and pmap (nos_arm_asm, nos_arm_pmap). Apple's own SoC configs
 # link those from the KDK's closed lib<SOC>.os.<CONFIG>.a instead, which is
 # arm64e and Apple-silicon specific. kperf/kpc stay (xnu does not build without
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -216,8 +216,8 @@
-#elif defined (PERIDOT) /* Qualcomm Kryo 470: Cortex-A76 + Cortex-A55 */
+#elif defined (PERIDOT) /* Qualcomm Kryo (SM8635): 64-byte cache lines */
 
 /* I-Cache. */
 #define MMU_I_CLINE 6
 
 /* D-Cache. */
 #define MMU_CLINE   6

diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -261,5 +261,5 @@
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
-# peridot's Cortex-A76/A55 have no pointer authentication: stay plain arm64
+# peridot has no Apple ARM64 arch family; stay plain arm64 (no arm64e ABI)
 ifneq ($(CURRENT_MACHINE_CONFIG),PERIDOT)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
diff --git a/osfmk/arm64/tunables/tunables.s b/osfmk/arm64/tunables/tunables.s
--- a/osfmk/arm64/tunables/tunables.s
+++ b/osfmk/arm64/tunables/tunables.s
@@ -1,7 +1,7 @@
 /*
  * peridot: Apple's per-SoC CPU tunables (implementation-defined HID/ACC
  * register settings applied in start.s) are not in the open source drop,
- * and none of them exist on Cortex-A76/A55. APPLY_TUNABLES does nothing.
+ * and none of them exist on peridot's Kryo cores. APPLY_TUNABLES does nothing.
  */
 .macro APPLY_TUNABLES midr, tmp1, tmp2
 .endmacro
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -956,7 +956,7 @@
 
 #if defined(PERIDOT)
-	/* Opt in to SMP: cpus=N (N <= PERIDOT_SMP_MAX_CPUS; cores 6-7 are the A76s). */
+	/* Opt in to SMP: cpus=N (N <= PERIDOT_SMP_MAX_CPUS; Aff1 0x3-0x7 are A720/X4). */
 	if (!cpus_boot_arg_present || cpu_boot_arg == 0) {
 		cpu_boot_arg = 1;
 	}
 	if (cpu_boot_arg > PERIDOT_SMP_MAX_CPUS) {
@@ -1086,6 +1086,6 @@
 
 #if defined(PERIDOT)
-		/* Aff1 encodes the core on SM7150, not an Apple cluster ID. */
+		/* Aff1 encodes the core on SM8635, not an Apple cluster ID. */
 		cpu->die_cluster_id = (int)ml_readprop(child, "die-cluster-id", 0);
 		cpu->cluster_core_id = (int)ml_readprop(child, "cluster-core-id", cpu->phys_id >> 8);
 #else
