+
+	if (!peridot_console_pace_parsed) {
+		peridot_console_pace_parsed = 1;
+		if (!PE_parse_boot_argn("peridotlogpace", &peridot_console_pace_usec,
+		    sizeof(peridot_console_pace_usec)) ||
+		    peridot_console_pace_usec < 0 ||
+		    peridot_console_pace_usec > PERIDOT_CONSOLE_PACE_MAX_US) {
+			peridot_console_pace_usec = 0;
+		}
+	}
+
 	peridot_log_append(c, size);
 	if (peridot_console_muted && !panic_active()) {
 		return;
@@ -296,6 +334,12 @@
 
