 int peridot_console_muted;
+/*
+ * Optional visual pacing for the kernel text console (boot-arg
+ * peridotlogpace=<usec>). The persistent log is written before this delay,
+ * so only the on-screen rendering is slowed down.
+ */
+static int peridot_console_pace_usec;
+static int peridot_console_pace_parsed;
+
+#define PERIDOT_CONSOLE_PACE_MAX_US 200000
+
+static inline void
+peridot_console_pace_delay(uint64_t usec)
+{
+	uint64_t freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+	uint64_t ticks;
+	uint64_t start;
+
+	if (freq == 0) {
+		return;
+	}
+	ticks = (freq * usec) / 1000000ULL;
+	start = __builtin_arm_rsr64("CNTVCT_EL0");
+	while ((__builtin_arm_rsr64("CNTVCT_EL0") - start) < ticks) {
+		__asm__ __volatile__("nop");
+	}
+}
 #endif
 
