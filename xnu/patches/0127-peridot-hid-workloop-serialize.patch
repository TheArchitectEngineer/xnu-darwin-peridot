+IOReturn
+IOHIDEventService::dispatchAction(OSObject *owner, void *arg0, void *arg1 __unused,
+    void *arg2 __unused, void *arg3 __unused)
+{
+	IOHIDEventService *service = (IOHIDEventService *)owner;
+	IOHIDEvent *event = (IOHIDEvent *)arg0;
+
+	if (service && event) {
+		service->dispatchEvent(event);
+	}
+	return kIOReturnSuccess;
+}
+
+void
+IOHIDEventService::dispatchEventOnWorkLoop(IOHIDEvent *event)
+{
+	if (!event) {
+		return;
+	}
+	if (!_hidGate || !_hidWorkLoop) {
+		dispatchEvent(event);
+		return;
+	}
+	_hidGate->runAction(&IOHIDEventService::dispatchAction, event, NULL, NULL, NULL);
+}
