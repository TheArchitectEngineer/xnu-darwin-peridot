--- a/bsd/dev/peridot_ufs.c
+++ b/bsd/dev/peridot_ufs.c
@@ -59,6 +59,8 @@
 #define CAP_64AS        (1u << 24)              /* 64-bit DMA addressing */
 
 #define UFS_BLOCK       4096u
+#define UFS_DEVICE_WLUN 0x50
+#define UFS_ACTIVE_PWR_MODE 1
 #define BOUNCE_SIZE     (1u << 20)
 #define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
 #define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
@@ -308,6 +310,23 @@
 	return error;
 }
 
+static int
+ufs_set_power_mode(uint8_t lun, uint8_t mode)
+{
+	uint8_t cdb[6] = { 0x1b, 0, 0, 0, (uint8_t)(mode << 4), 0 };
+	uint8_t old = su.lun;
+	int error;
+
+	su.lun = lun;
+	error = ufs_scsi(cdb, sizeof(cdb), 0, false);
+	if (error) {
+		(void)ufs_request_sense();
+		error = ufs_scsi(cdb, sizeof(cdb), 0, false);
+	}
+	su.lun = old;
+	return error;
+}
+
 /*
  * WRITE(10) of count device blocks from the bounce buffer to lba. The range
  * must lie inside the partition: this is the only place data goes out.
@@ -663,6 +682,12 @@
 	lck_mtx_lock(&peridot_ufs_lock);
 	error = ufs_take_over_host();
 	if (!error) {
+		error = ufs_set_power_mode(UFS_DEVICE_WLUN, UFS_ACTIVE_PWR_MODE);
+		if (error) {
+			printf("PERIDOT UFS: active power mode failed %d\n", error);
+			error = 0;
+		}
+		delay(1000);
 		(void)ufs_request_sense();
 		static const uint8_t tur[6] = { 0x00 };
 		int tur_error = 0;
