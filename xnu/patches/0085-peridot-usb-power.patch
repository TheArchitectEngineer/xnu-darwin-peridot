+#define GCC_USB30_PRIM_BCR      0x39000         /* gcc-cliffs.c reset map */
+#define GCC_QUSB2PHY_PRIM_BCR   0x12000
+#define TCSRCC_PA               0x01f40000      /* DT clock-controller@1f40000 */
+#define TCSRCC_SIZE             0x000c0000
+#define TCSR_USB2_CLKREF_EN     0x000b1118      /* tcsrcc-pineapple.c */
+
 #define DWC3_PA                 0x0a600000
 #define DWC3_SIZE               0x0000d000
 #define EUSB2_PHY_PA            0x088e3000      /* DT hsphy@88e3000 */
