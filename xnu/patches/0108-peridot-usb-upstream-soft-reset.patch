--- a/bsd/dev/peridot_usb.c
+++ b/bsd/dev/peridot_usb.c
@@ -1126,14 +1126,18 @@
 	ud.dma_pa = ptoa_64(pn);
 	ud_if_create();
 
-	/* UEFI hands over a fully initialized device controller. Halting it
-	 * and replacing the event buffer is enough; a CSFTRST would discard
-	 * global state (FIFOs, GSBUSCFG) that is not rebuilt here. */
-	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
-	delay(1000);
-	printf("PERIDOT USB: halted after handoff, GCTL 0x%08x DCFG 0x%08x\n",
-	    dwc_rd(GCTL), dwc_rd(DCFG));
+	/* Match sweet's controller bring-up: reset the device controller and
+	 * rebuild endpoint 0 from scratch instead of trusting UEFI's state. */
+	dwc_wr(DCTL, DCTL_CSFTRST);
 	int i;
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	printf("PERIDOT USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return;
+	}
 
 	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
 	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
@@ -1161,12 +1165,11 @@
 	/* Events: disconnect, USB reset, connect done */
 	dwc_wr(DEVTEN, 0x7);
 
-	/* Endpoint 0 OUT/IN: start config, control type, max packet 64 (HS). */
-	dwc_wr(DALEPENA, 0);
+	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
 	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
-	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
 	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
-	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
 	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
 		printf("PERIDOT USB: endpoint 0 setup failed\n");
 		return;
