 static void
 ud_start_setup(void)
 {
+	/*
+	 * The controller keeps an armed SETUP TRB across bus resets, so only
+	 * hand it a new one when the previous one was consumed (or aborted).
+	 */
+	if (ud.ep0_armed) {
+		return;
+	}
 	ud.state = EP0_SETUP;
-	ud_start(0, UD_SETUP, 8, TRBCTL_SETUP);
+	if (ud_start(0, UD_SETUP, 8, TRBCTL_SETUP) == 0) {
+		ud.ep0_armed = true;
+	}
 }
 
 static void
 ud_stall(void)
 {
+	ud.ep0_armed = false;
 	ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
 	ud_start_setup();
 }
