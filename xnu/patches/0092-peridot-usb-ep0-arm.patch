 static int
 ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
 {
+	/*
+	 * Databook 3.30a 3.2.2: at USB 2.0 speeds ENBLSLPM and SUSPHY must be
+	 * clear while an endpoint command runs or the command is rejected.
+	 * Linux does the same in dwc3_send_gadget_ep_cmd().
+	 */
+	uint32_t gusb2 = dwc_rd(0xc200);
+	uint32_t saved = gusb2 & ((1u << 6) | (1u << 8));
+	int ret = 0;
+
+	if (saved) {
+		dwc_wr(0xc200, gusb2 & ~saved);
+	}
 	dwc_wr(DEPCMDPAR0(ep), p0);
 	dwc_wr(DEPCMDPAR1(ep), p1);
 	dwc_wr(DEPCMDPAR2(ep), p2);
