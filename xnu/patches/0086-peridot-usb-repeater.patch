+/*
+ * The eUSB2 PHY has no analog USB2 transceiver: the PM7550BA repeater
+ * (SPMI SID 7, peripheral 0xfd00) drives D+/D- and owns VBUS detection.
+ * ABL re-enables it for fastboot, so it may be off here; without it the
+ * PHY never pulls D+ up and the host sees no connect. Sequence from the
+ * downstream repeater-qti-pmic-eusb2.c driver with peridot's device-mode
+ * parameter overrides.
+ */
+#define RPTR_SID        7
+#define RPTR_BASE       0xfd00
+#define RPTR_EN_CTL1    0x46
+#define RPTR_STATUS     0x08
+#define RPTR_RPTR_EN   (1u << 7)
+#define RPTR_RPTR_OK   (1u << 7)
+
+static int
+rptr_rd(unsigned reg, uint8_t *value)
+{
+	return peridot_spmi_read(RPTR_SID, RPTR_BASE + reg, value);
+}
+
+static int
+rptr_wr(unsigned reg, uint8_t value)
+{
+	return peridot_spmi_write(RPTR_SID, RPTR_BASE + reg, value);
+}
+
+static void
+peridot_usb_repeater_on(void)
+{
+	/* value, register pairs from the DT qcom,param-override-seq */
+	static const uint8_t tune[][2] = {
+		{ 0x00, 0x50 }, { 0x0c, 0x51 }, { 0x03, 0x52 }, { 0x07, 0x53 },
+		{ 0x02, 0x54 }, { 0x03, 0x55 }, { 0x00, 0x56 }, { 0x04, 0x57 },
+		{ 0x02, 0x58 }, { 0x00, 0x59 }, { 0x03, 0x5a }, { 0x02, 0x5b },
+		{ 0x00, 0x5c },
+	};
+	uint8_t value = 0;
+	unsigned i;
+
+	if (peridot_spmi_init() != 0) {
+		printf("PERIDOT USB: repeater SPMI unavailable\n");
+		return;
+	}
+	if (rptr_rd(0x00, &value) != 0) {
+		printf("PERIDOT USB: repeater not responding (SID %u, 0x%x)\n",
+		    RPTR_SID, RPTR_BASE);
+		return;
+	}
+	printf("PERIDOT USB: repeater revision 0x%02x\n", value);
+	/* Bring out of reset (RPTR_EN) before the tuning writes. */
+	if (rptr_rd(RPTR_EN_CTL1, &value) != 0) {
+		return;
+	}
+	if (rptr_wr(RPTR_EN_CTL1, value | RPTR_RPTR_EN) != 0) {
+		printf("PERIDOT USB: repeater RPTR_EN failed\n");
+		return;
+	}
+	for (i = 0; i < sizeof(tune) / sizeof(tune[0]); i++) {
+		if (rptr_wr(tune[i][1], tune[i][0]) != 0) {
+			printf("PERIDOT USB: repeater tune 0x%02x failed\n",
+			    tune[i][1]);
+			break;
+		}
+	}
+	/* Device mode: clear the 19.2 MHz host-mode workaround. */
+	if (rptr_rd(0xe8, &value) == 0) {
+		(void)rptr_wr(0xe8, value & ~0x40);
+	}
+	if (rptr_rd(0xed, &value) == 0) {
+		(void)rptr_wr(0xed, value & ~0x40);
+	}
+	for (i = 0; i < 100; i++) {
+		if (rptr_rd(RPTR_STATUS, &value) == 0 &&
+		    (value & RPTR_RPTR_OK)) {
+			break;
+		}
+		delay(1);
+	}
+	printf("PERIDOT USB: repeater status 0x%02x (%s)\n", value,
+	    (value & RPTR_RPTR_OK) ? "OK" : "NOT OK");
+}
