diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..4695d86 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1828,22 +1828,32 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #if defined(SWEET)
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
- * Use the otherwise empty 32MB block above low globals and below gVirtBase
- * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ * peridot's framebuffer (0xE3940000) crosses the 32MB boundary at
+ * 0xE4000000, so use the two otherwise empty 32MB blocks above low globals
+ * and below gVirtBase for a Normal-NC framebuffer alias that survives
+ * bootstrap TTBR0 teardown.
  */
+#define SWEET_FB_PHYS 0xE3940000ULL
+#define SWEET_FB_BLOCK (SWEET_FB_PHYS & ~(ARM_TT_L2_SIZE - 1))
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
 
 static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	assert(va + 2 * ARM_TT_L2_SIZE <= gVirtBase);
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	assert(slot[1] == ARM_TTE_EMPTY);
+	slot[0] = SWEET_FB_BLOCK | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	slot[1] = (SWEET_FB_BLOCK + ARM_TT_L2_SIZE) |
+	    ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
@@ -2189,8 +2199,8 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	ml_enable_monitor();
 
 #if defined(SWEET)
-	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	sweet_early_relocate(SWEET_EARLY_FB_VA);
+	/* The final TTBR1 is live; re-point the console at the framebuffer alias. */
+	sweet_early_relocate(SWEET_EARLY_FB_VA + (SWEET_FB_PHYS & (ARM_TT_L2_SIZE - 1)));
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
