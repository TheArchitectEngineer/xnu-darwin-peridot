+static int
+touch_parse_ic_info(const uint8_t *d, unsigned len)
+{
+	if (len < 2u + 16u + 10u + 5u || touch_le16(d) != len ||
+	    !touch_checksum(d, len)) return EIO;
+	unsigned p = 2u + 16u + 10u;
+	/* drv/sensor/button/force counts are fixed bytes, not frequency arrays. */
+	if (p + 4u > len - 2u) return EIO;
+	p += 4u;
+	for (unsigned group = 0; group < 5; ++group) {
+		if (p >= len - 2u) return EIO;
+		unsigned n = d[p++];
+		if (n > 8u || n * 2u > len - 2u - p) return EIO;
+		p += n * 2u;
