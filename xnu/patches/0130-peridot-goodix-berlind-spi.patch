+	/* misc prefix through touch_data_addr/head/point sizes */
+	if (p + 130u + 20u > len - 2u) return EIO;
+	/* packed goodix_ic_info_misc: 130 bytes; other begins with a 20-byte layout. */
+	st.touch_addr = touch_le32(d + p + 44u);
+	st.touch_head_len = touch_le16(d + p + 48u);
+	st.point_len = touch_le16(d + p + 50u);
+	st.screen_x = touch_le16(d + p + 130u + 16u);
+	st.screen_y = touch_le16(d + p + 130u + 18u);
+	if (!st.touch_addr || st.touch_head_len != GOODIX_HEAD_LEN ||
+	    st.point_len != GOODIX_POINT_LEN || !st.screen_x || !st.screen_y) return EIO;
