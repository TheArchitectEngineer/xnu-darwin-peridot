diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index ccbb188..777aca4 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -463,6 +463,35 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(PERIDOT)
+	/* Stage 0: white 64x32 band from boot_args Video, no stack needed. */
+	ldr		x0, [x20, #40]			// Video.v_baseAddr
+	cbz		x0, Lperidot_mark_skip
+	ldr		x4, [x20, #56]			// Video.v_rowBytes
+	cbz		x4, Lperidot_mark_skip
+	ldr		x2, [x20, #72]			// Video.v_height
+	cmp		x2, #32
+	b.lo	Lperidot_mark_skip
+	add		x0, x0, x4, lsl #5
+	mul		x5, x4, x2
+	add		x0, x0, x5
+	sub		x0, x0, x4, lsl #6		// (row 0 + height - 32 rows)
+	mov		w1, #-1
+	mov		x2, #32
+Lperidot_mark_row:
+	mov		x3, #64
+	mov		x5, x0
+Lperidot_mark_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lperidot_mark_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lperidot_mark_row
+	dsb		sy
+Lperidot_mark_skip:
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -609,6 +638,27 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(PERIDOT)
+	/*
+	 * Loader framebuffer: map the 32MB Normal-NC block that contains the
+	 * boot_args Video base in the EXISTING V=P L2 table. Both framebuffer
+	 * and RAM use L1 index 0; another call to create_bootstrap_mapping
+	 * would replace the RAM L2 table. PERIDOT uses 16K pages and all
+	 * bring-up RAM is below 4GB, so the first V=P L2 page is
+	 * bootstrap_pagetables + 2*PGBYTES.
+	 */
+	ldr		x10, [x20, #40]			// Video.v_baseAddr
+	cbz		x10, Lperidot_fb_skip
+	bic		x10, x10, #(ARM_TT_L2_SIZE - 1)
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+Lperidot_fb_skip:
+#endif
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
diff --git a/osfmk/arm64/peridot_early.c b/osfmk/arm64/peridot_early.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/peridot_early.c
@@ -0,0 +1,179 @@
+/*
+ * Poco F6 (SM8635) bootstrap console. No allocation, locks, ADT parsing or
+ * per-CPU state: panic() can reach this before a current thread exists.
+ * start.s maps the boot loader's framebuffer VA=PA as Normal Non-Cacheable
+ * memory. arm_vm_init installs a reserved kernel VA alias before removing
+ * TTBR0; retain this console until the normal framebuffer serial console is
+ * ready.
+ */
+#include <arm64/peridot_early.h>
+
+#if defined(PERIDOT)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+#include <pexpert/arm64/boot.h>
+
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+
+extern unsigned char iso_font[256 * 16];
+
+/* Set from boot_args Video in arm_init(); VA=PA until peridot_early_relocate. */
+static volatile uint32_t *early_fb;
+static uint64_t early_fb_pa;
+static uint32_t early_width, early_height, early_stride, early_rows, early_cols;
+static unsigned int early_row, early_col;
+/* Initialized data must remain writable until disable, including panics. */
+static unsigned int early_started, early_disabled, early_panicking;
+
+void
+peridot_early_set_video(boot_args *args)
+{
+	const Boot_Video *v = &args->Video;
+
+	if (args->Revision < kBootArgsRevision2 || v->v_baseAddr == 0 ||
+	    v->v_width == 0 || v->v_height == 0 || v->v_width > 8192 ||
+	    v->v_height > 8192 || v->v_rowBytes < v->v_width * 4 ||
+	    v->v_rowBytes > 8192u * 4u || (v->v_baseAddr & 3u) != 0) {
+		return;
+	}
+	early_fb = (volatile uint32_t *)(uintptr_t)v->v_baseAddr;
+	early_fb_pa = v->v_baseAddr;
+	early_width = (uint32_t)v->v_width;
+	early_height = (uint32_t)v->v_height;
+	early_stride = (uint32_t)(v->v_rowBytes / 4u);
+	early_rows = (early_height - 32u) / EARLY_CELL_H;
+	early_cols = early_width / EARLY_CELL_W;
+}
+
+int
+peridot_early_video(uint64_t *pa, uint32_t *w, uint32_t *h, uint32_t *stride)
+{
+	if (early_fb == NULL) {
+		return -1;
+	}
+	*pa = early_fb_pa;
+	*w = early_width;
+	*h = early_height;
+	*stride = early_stride * 4u;
+	return 0;
+}
+
+static void
+peridot_early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = early_fb + (early_row * EARLY_CELL_H + y) * early_stride;
+		for (unsigned int x = 0; x < early_width; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+}
+
+void
+peridot_early_putc(char c)
+{
+	if (early_disabled || early_fb == NULL) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		peridot_early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col == early_cols) {
+		early_col = 0;
+		early_row = (early_row + 1) % early_rows;
+		peridot_early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = early_fb +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * early_stride +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	early_col++;
+}
+
+static void
+peridot_early_string(const char *s)
+{
+	while (*s) {
+		peridot_early_putc(*s++);
+	}
+}
+
+void
+peridot_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || early_fb == NULL || stage > 20) {
+		return;
+	}
+	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+	for (unsigned int y = early_height - 32; y < early_height; y++) {
+		for (unsigned int x = stage * 48; x < (stage + 1) * 48 && x < early_width; x++) {
+			early_fb[y * early_stride + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	peridot_early_string("PERIDOT EARLY ");
+	if (stage >= 10) {
+		peridot_early_putc((char)('0' + stage / 10));
+	}
+	peridot_early_putc((char)('0' + stage % 10));
+	peridot_early_string(": ");
+	peridot_early_string(label);
+	peridot_early_putc('\n');
+}
+
+void
+peridot_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking || early_fb == NULL) {
+		return;
+	}
+	early_panicking = 1;
+	peridot_early_string("\nPERIDOT EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, peridot_early_putc, 16);
+	va_end(copy);
+	peridot_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+peridot_early_relocate(uint64_t base)
+{
+	if (early_fb == NULL) {
+		return;
+	}
+	peridot_early_mark(8, "leaving bootstrap TTBR0");
+	/* The alias maps the 32MB block at block+offset, not at offset 0. */
+	early_fb = (volatile uint32_t *)(uintptr_t)(base + (early_fb_pa & 0x1ffffffULL));
+	__asm__ volatile("dsb sy" ::: "memory");
+	peridot_early_mark(9, "kernel framebuffer VA live");
+}
+
+void
+peridot_early_disable(void)
+{
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* PERIDOT */
diff --git a/osfmk/arm64/peridot_early.h b/osfmk/arm64/peridot_early.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/peridot_early.h
@@ -0,0 +1,37 @@
+/* Screen diagnostics through bootstrap TTBR0 and the final kernel TTBR1. */
+#ifndef _ARM64_PERIDOT_EARLY_H_
+#define _ARM64_PERIDOT_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#if defined(PERIDOT)
+struct boot_args;
+void peridot_early_set_video(struct boot_args *args);
+int peridot_early_video(uint64_t *pa, uint32_t *w, uint32_t *h, uint32_t *stride);
+void peridot_early_mark(unsigned int stage, const char *label);
+void peridot_early_putc(char c);
+void peridot_early_panic(const char *fmt, va_list *args);
+void peridot_early_relocate(uint64_t base);
+void peridot_early_disable(void);
+#else
+static inline void peridot_early_set_video(void *args) { (void)args; }
+static inline int peridot_early_video(uint64_t *pa, uint32_t *w, uint32_t *h, uint32_t *stride)
+{
+	(void)pa;
+	(void)w;
+	(void)h;
+	(void)stride;
+	return -1;
+}
+static inline void peridot_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void peridot_early_relocate(uint64_t base) { (void)base; }
+static inline void peridot_early_disable(void) {}
+#endif
+
+#endif
